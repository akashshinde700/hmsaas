# Database URL
# Local / fast embedded mode (SQLite with WAL):
DATABASE_URL="file:./hmsaas.db"
# Production MySQL 8 (switch prisma/schema.prisma provider to "mysql" or copy prisma/schema.mysql.prisma):
# DATABASE_URL="mysql://hms_user:strong_password@127.0.0.1:3306/aethermed_hms"

# Auth & Platform Credential Encryption
JWT_SECRET="replace-with-64-char-random-secret"
SECRET_ENCRYPTION_KEY="replace-with-32-byte-secret-key!"

# MedWiki Continuous Scraper -> SaaS Webhook Ingestion Key
MEDWIKI_SYNC_API_KEY="mwk_live_replace_with_strong_sync_token"
LIGHTPANDA_CDP_URL="ws://127.0.0.1:9222"

# Public SaaS Branding
NEXT_PUBLIC_APP_NAME="AetherMed Cloud HMS"
NEXT_PUBLIC_COMPANY_NAME="AetherDev Solutions"
