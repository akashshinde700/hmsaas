# =============================================================================
# AetherMed HMS — Environment Variables (Hostinger VPS)
# Copy to .env and fill in your values
# =============================================================================

# --- Database (SQLite via @libsql/client) ---
DATABASE_URL="file:./prisma/hmsaas.db"

# --- NextAuth / Session ---
NEXTAUTH_SECRET="$(openssl rand -base64 32)"
NEXTAUTH_URL="https://your-domain.com"
BASE_URL="https://your-domain.com"

# --- App Port ---
PORT=3000
HOST=0.0.0.0

# --- MedWiki Sync (HMS-side API protection) ---
MEDWIKI_SYNC_API_KEY="mwk_live_your_secret_key_here"
MEDWIKI_CRON_SECRET="cron_secret_change_this"

# --- MedWiki Remote (used by separate medwiki-service on port 4000) ---
MEDWIKI_API_BASE_URL="https://api.medwiki.example.com"
MEDWIKI_API_KEY="your-medwiki-api-key"

# --- GLM Free API (Z.AI / Zhipu AI) — generates medicine instructions ---
# Free models: glm-4.7-flash, glm-4.5-flash, glm-4.6v-flash
# Get free key at: https://z.ai
GLM_API_KEY="your-z-ai-api-key"
GLM_API_BASE="https://api.z.ai/api/paas/v4"

# --- Platform Admin ---
PLATFORM_ADMIN_EMAIL="aetherdevsolutions@gmail.com"
PLATFORM_ADMIN_PASSWORD="Admin@123"
